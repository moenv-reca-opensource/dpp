{
  "name": "battery-dpp-backstage",
  "version": "1.0.0",
  "private": true,
  "description": "可獨立部署的 Vue 3 後台前端，提供電池類別的產品數位護照資料維護。A standalone Vue 3 administration frontend for battery digital product passports.",
  "license": "MIT",
  "keywords": [
    "digital-product-passport",
    "dpp",
    "battery",
    "vue3",
    "vite",
    "element-plus",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moenv-reca-opensource/dpp.git"
  },
  "homepage": "https://github.com/moenv-reca-opensource/dpp#readme",
  "bugs": {
    "url": "https://github.com/moenv-reca-opensource/dpp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm-run-all -p typecheck build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "preview:csp": "node scripts/csp-server.mjs",
    "lint": "npm-run-all lint:eslint lint:format",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:format": "prettier --check \"**/*.{css,html,js,mjs,ts,vue}\"",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.19.0",
    "element-plus": "^2.14.4",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
